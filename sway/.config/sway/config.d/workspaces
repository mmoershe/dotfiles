# 1
workspace 1 name "Terminal"
assign [app_id=$term] 1
bindsym $mod+Return workspace number 1
bindsym $mod+Shift+Return move container to workspace number 1

# 3
workspace 3 name "Browser"
assign [app_id="zen"] 3
bindsym $mod+b workspace number 3
bindsym $mod+Shift+b move container to workspace number 3

# 5
workspace 5 name "File-Browser"
assign [app_id=$file-browser] 5
bindsym $mod+z workspace number 5
bindsym $mod+Shift+z move container to workspace number 5

# 9
workspace 9 name "Chat"
assign [class="discord"] 9
assign [class="elecwhat"] 9
bindsym $mod+i workspace number 9
bindsym $mod+Shift+i move container to workspace number 9



