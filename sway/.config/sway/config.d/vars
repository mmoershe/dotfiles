# Windows key
set $mod Mod4

# Machines
set $machine MACHINE_VARIABLE

# Vim Directions
set $left h
set $down j
set $up k
set $right l

# Applications
set $term kitty
set $file-browser dolphin
set $launcher wofi --show drun 
set $menu nwg-drawer
set $powermenu $HOME/.config/sway/scripts/power_menu.sh

# Directories
set $wallpaper_directory $HOME/Pictures/wallpapers/wallpaper.jpg
