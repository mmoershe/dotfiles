// -*- mode: json -*-

{
	// ****
	// MAIN
	// ****

	"height": 40, 
	"margin-top": 10,
	"margin-right": 10,
	"margin-left": 10,
	"spacing": 12,
	"position": "top",
	"reload_style_on_change": true,

	"modules-left": [
		"custom/wlogout",
		"tray",
		"sway/window"
	],
	"modules-center": [
		"sway/workspaces"
	],
	"modules-right": [
		"network",
		"cpu",
		"memory",
		"temperature",
		"clock",
		"backlight",
		"pulseaudio",
		"battery"
	],



	// ****
	// MODULES
	// ****
	"hyprland/workspaces": {
		// "persistent_workspaces": {
		//     "1": [],
		//     "2": [],
		//     "3": [],
		//     "4": [],
		//     "5": []
		// },
		"show-special": true,
		"disable-scroll": true,
		"all-outputs": true,
		"on-click": "activate"
		/*
		"format": "{icon}",
		*/
				/*
		"format-icons": {
		    "active": "",
		    "empty": "",
		    "default": "",
		    // "default": "",
		    "urgent": "",
		    "special": "󰠱"
		}
		*/
	},

	"hyprland/window": {
		"icon": true,
		"icon-size": 20,
		"max-length": 70,
		"rewrite": {
		    "(.*) — Mozilla Firefox": "Firefox",
		    "(.*) — Sublime Text(.*)": "$1 - Sublime Text"
		}
	},

	"backlight": {
		"device": "intel_backlight",
		"format": "󰛨 {percent}%"
	},

	"battery": {
		"states": {
		    "good": 95,
		    "warning": 30,
		    "critical": 20
		},
		"format": "{icon} {capacity}%",
		"format-charging": " {capacity}%",
		"format-plugged": " {capacity}%",
		"format-alt": "{time} {icon}",
		"format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
	},

	"temperature": {
		"tooltip": true,
		"format": " {temperatureC}°C"
	},

	"network": {
		"tooltip": true,
		"format-wifi": "<span foreground='#FF8B49'> {bandwidthDownBytes}</span> <span foreground='#FF6962'> {bandwidthUpBytes}</span>",
		"format-ethernet": "<span foreground='#FF8B49'> {bandwidthDownBytes}</span> <span foreground='#FF6962'> {bandwidthUpBytes}</span>",
		"tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
		"format-linked": "󰈀 {ifname} (No IP)",
		"format-disconnected": " 󰖪 ",
		"tooltip-format-disconnected": "Disconnected",
		"interval": 5,
		"on-click-right": "~/.config/waybar/network.py"
	  },

	"custom/wlogout": {
		  "format": "  {}",
		  "on-click": "wlogout"
	  },

	"cpu": {
		"format": " {usage}%",
		"interval": 5
	},

	"memory": {
		"interval": 5,
		"format": " {percentage}%",
	},
	"pulseaudio": {
	    "format": "{icon} {volume}%",
	    "format-bluetooth": "{icon} {volume}%",
	    "format-muted": "",
	    "format-icons": {
		//"alsa_output.pci-0000_00_1f.3.analog-stereo": "",
		//"alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
		"headphone": "",
		"hands-free": "",
		"headset": "",
		"phone": "",
		"phone-muted": "",
		"portable": "",
		"car": "",
		"default": ["", " "]
	    },
	    "scroll-step": 1,
	    "on-click": "pavucontrol",
	    "ignored-sinks": ["Easy Effects Sink"]
	},
	"tray": {
		"spacing": 10
	}
}
